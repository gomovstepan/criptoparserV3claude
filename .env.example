# ============================================
# БАЗА ДАННЫХ (TimescaleDB)
# ============================================
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_USER=arbitrage
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=arbitrage_db

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ============================================
# API GATEWAY
# ============================================
API_GATEWAY_PORT=8000
JWT_SECRET=your_jwt_secret_key_min_32_chars_long
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173

# ============================================
# COLLECTOR
# ============================================
COLLECTOR_PORT=8001
TRACKED_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,SUI/USDT,ADA/USDT,AVAX/USDT,ZEC/USDT,LINK/USDT,PEPE/USDT,LTC/USDT,NEAR/USDT,XMR/USDT,UNI/USDT,BNB/USDT,DOT/USDT,PENGU/USDT,WLD/USDT,SHIB/USDT,TON/USDT,ARB/USDT,HTX/USDT,OP/USDT,IMX/USDT,APT/USDT,SEI/USDT,TIA/USDT,INJ/USDT,ENA/USDT,PYTH/USDT,BLUR/USDT,AEVO/USDT,FLOKI/USDT,BONK/USDT,WIF/USDT,MEME/USDT

# ============================================
# SCANNER
# ============================================
SCANNER_PORT=8002

# ============================================
# EXECUTOR
# ============================================
EXECUTOR_PORT=8003
# Режим торговли: true — paper (симуляция на виртуальных балансах),
# false — реальная торговля (НЕ реализована, executor не создаёт сделки).
PAPER=true

# ============================================
# NOTIFIER (Telegram)
# ============================================
NOTIFIER_PORT=8004
# Секреты бота (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) живут в отдельном
# файле .env.notifier (см. .env.notifier.example) — его через env_file
# получает ТОЛЬКО сервис notifier, остальным контейнерам токен не виден.

# ============================================
# PROMETHEUS / GRAFANA
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin

# ============================================
# FRONTEND
# ============================================
FRONTEND_PORT=5173
# VITE_* здесь намеренно нет: Vite читает env-файлы только из каталога frontend/,
# корневой .env он не видит. И в dev, и в контейнере фронтенд ходит по
# относительным путям — в dev их проксирует vite.config.ts, в проде nginx.conf.

# ============================================
# ЛОГИРОВАНИЕ (shared/logging_config.py)
# ============================================
# Каталог для файловых логов внутри контейнера (bind-mount ./logs:/app/logs).
LOG_DIR=/app/logs
# Уровень: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
