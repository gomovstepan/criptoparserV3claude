# Секреты / окружение
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Node / Frontend
node_modules/
dist/
.vite/
*.local
# Инкрементальные кеши tsc — машинно-локальные артефакты, меняются на каждой
# сборке и дают ложные диффы. Ранее были закоммичены и хранили устаревший
# список файлов в нижнем регистре (следы сборки на Windows).
*.tsbuildinfo

# Docker volumes (на случай локального bind)
tsdb_data/
prometheus_data/
grafana_data/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Логи
*.log
*.log.*
# Каталог логов сервисов (bind-mount ./logs) целиком, кроме плейсхолдера.
logs/*
!logs/.gitkeep
graphify-out/*
.env.notifier
